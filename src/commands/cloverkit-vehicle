#!/usr/bin/env python3
"""CloverKit offline vehicle CLI; bundled dependencies require no runtime downloads."""
import sys
from pathlib import Path
base=Path('/usr/local/lib/cloverkit/vehicle')
if not base.exists():base=Path(__file__).resolve().parents[1]/'vehicle'
sys.path[:0]=[str(base),str(base/'vendor')]
from cloverkit_vehicle.__main__ import main
if __name__=='__main__':
    try:main()
    except (ValueError,OSError,KeyboardInterrupt) as e:print('CloverKit: '+str(e),file=sys.stderr);raise SystemExit(1)
