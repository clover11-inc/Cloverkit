#!/usr/bin/env python3
"""Cloverkit client health: read-only radio observations and bounded active tests."""
import signal
import argparse, datetime, json, os, re, shutil, statistics, subprocess, sys, tempfile, threading, time
from pathlib import Path

os.environ['PATH'] = os.environ.get('PATH', '') + ':/usr/local/sbin:/usr/sbin:/sbin'
ENV = dict(os.environ, LC_ALL='C')
LOCK = threading.Lock()

def command(args, timeout=8):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=ENV)
        return p.returncode, p.stdout, p.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, '', str(e)

def number(text, pattern):
    m = re.search(pattern, text, re.M)
    return float(m.group(1)) if m else None

def radio(iface):
    verify_external(iface)
    rc, link, err = command(['iw', 'dev', iface, 'link'])
    sc, station, se = command(['iw', 'dev', iface, 'station', 'dump'])
    m = re.search(r'Connected to ([0-9a-f:]+)', link, re.I)
    out = {'connected': bool(m), 'bssid': m.group(1) if m else None,
           'ssid': (re.search(r'^\s*SSID: (.*)$', link, re.M).group(1) if re.search(r'^\s*SSID: (.*)$', link, re.M) else None),
           'signal': number(link, r'^\s*signal:\s*(-?[\d.]+)'),
           'frequency': number(link, r'^\s*freq:\s*(\d+)'),
           'tx_rate': number(station or link, r'^\s*tx bitrate:\s*([\d.]+)'),
           'rx_rate': number(station, r'^\s*rx bitrate:\s*([\d.]+)'),
           'error': err if rc else (se if sc else None)}
    for field in ('tx packets', 'tx retries', 'tx failed', 'rx bytes', 'tx bytes'):
        out[field] = number(station, r'^\s*' + re.escape(field) + r':\s*(\d+)')
    out['raw_link'], out['raw_station'] = link, station
    return out

def ping(iface, target):
    rc, out, err = command(['ping', '-n', '-I', iface, '-c', '10', '-i', '0.3', '-W', '1', target], 16)
    loss = number(out, r'([\d.]+)% packet loss')
    m = re.search(r'(?:rtt|round-trip).*?= ([\d.]+)/([\d.]+)/([\d.]+)/([\d.]+)', out)
    return {'target': target, 'loss': loss, 'avg_ms': float(m.group(2)) if m else None,
            'max_ms': float(m.group(3)) if m else None, 'mdev_ms': float(m.group(4)) if m else None,
            'status': 'measured' if loss is not None else 'unavailable', 'error': err or None, 'raw': out}

def route_ok(ip, source, iface):
    rc, out, err = command(['ip', '-j', '-4', 'route', 'get', ip, 'from', source])
    try:
        routes = json.loads(out)
        return rc == 0 and bool(routes) and routes[0].get('dev') == iface
    except ValueError:
        return False

def coverage(samples):
    values = [s['signal'] for s in samples if s.get('signal') is not None]
    if not values: return 'UNKNOWN', None
    avg = statistics.mean(values)
    return ('STRONG' if avg >= -60 else 'GOOD' if avg >= -67 else 'MARGINAL' if avg >= -75 else 'WEAK'), avg

