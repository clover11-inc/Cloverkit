    def trends(self,now,aps,clients,surveys):
        # Compare the same source/metric only. Re-rendering old observations adds no evidence.
        self.trend_history={key:series for key,series in self.trend_history.items() if series[-1][0]>=now-300}
        metadata={}
        def observe(key,label,metric,value,observed,direction,change,bad):
            if value is None or observed is None or observed<now-60: return
            metadata[key]=(label,metric,direction,change,bad)
            if key not in self.trend_history:
                if len(self.trend_history)>=5000: return
                self.trend_history[key]=collections.deque(maxlen=30)
            series=self.trend_history[key]
            while series and series[0][0]<now-300: series.popleft()
            if not series or observed-series[-1][0]>=10: series.append((observed,value))
        for a in aps:
            raw=self.aps[(a['bssid'],a['frequency'])]; identity=(a['bssid'],a['frequency'])
            label=a['ssid']; signal_time=raw['ap_signal'][-1][0] if raw['ap_signal'] else None
            snr_time=raw['snr'][-1][0] if raw['snr'] else None
            data_time=raw['window'][-1][0] if raw['window'] else None
            observe(identity+('signal',),label,'AP signal',a['signal_dbm'],signal_time,1,5,lambda v:v<-75)
            observe(identity+('snr',),label,'SNR',a['snr_db'],snr_time,1,5,lambda v:v<20)
            if a['recent_data_frames']>=100:
                observe(identity+('retries',),label,'retries',a['recent_retry_percent'],data_time,-1,10,lambda v:v>=20)
            observe(identity+('load',),label,'AP load',a['ap_reported_busy_percent'],raw['load_time'],-1,15,lambda v:v>=70)
        for c in clients:
            identity=(c['ap'],c['client'],c['frequency']); raw=self.clients[identity]
            observe(identity+('signal',),c['client'],'client signal',c['signal_dbm'],raw['signal'][-1][0] if raw['signal'] else None,1,5,lambda v:v<-75)
            for direction,x in c.get('directions',{}).items():
                if x['frames']>=100:
                    observed=now-x['last_seen_seconds'] if x['last_seen_seconds'] is not None else None
                    observe(identity+('link-retries',direction),c['client'],'link retries',x['retry_percent'],observed,-1,10,lambda v:v>=20)
        for s in sorted(surveys,key=lambda s:s['time']):
            identity=(s['radio'],s['frequency']); label=str(s['frequency'])+' MHz'
            observe(identity+('busy',),label,'channel load',s['busy_percent'],s['time'],-1,15,lambda v:v>=70)
            observe(identity+('noise',),label,'noise',s['noise_dbm'],s['time'],-1,5,lambda v:False)
        result=[]
        for key,(label,metric,direction,change,bad) in metadata.items():
            series=self.trend_history.get(key,[])
            if len(series)<3 or series[-1][0]-series[0][0]<30 or series[-1][0]<now-60: continue
            mid=len(series)//2
            delta=statistics.median(v for _,v in list(series)[mid:])-statistics.median(v for _,v in list(series)[:mid])
            quality=delta*direction
            status='WORSENING' if quality<=-change else 'IMPROVING' if quality>=change else 'PERSISTENT' if series[-1][0]-series[0][0]>=60 and bad(series[-1][1]) and sum(bad(v) for _,v in series)/len(series)>=.8 else 'STABLE'
            result.append({'status':status,'metric':metric,'source':label,'identity':list(key),'delta':round(delta,1),'samples':len(series),'span_seconds':round(series[-1][0]-series[0][0])})
            result[-1].update(early_median=round(statistics.median(v for _,v in list(series)[:mid]),1),
                              late_median=round(statistics.median(v for _,v in list(series)[mid:]),1),
                              change_threshold=change,higher_is_better=direction==1,
                              warning_readings=sum(bad(v) for _,v in series),last_reading_warning=bad(series[-1][1]),
                              readings=[dict(age_seconds=round(now-t,1),value=round(v,1),warning=bad(v)) for t,v in series])
        return sorted(result,key=lambda r:({'WORSENING':0,'PERSISTENT':1,'IMPROVING':2,'STABLE':3}[r['status']],r['metric']))
