    def cleanup(self):
        # CLOVERKIT_VERIFIED_RADIO_CLEANUP_V1
        self.stop.set()
        failures=[]
        def attempt(args,seconds=10):
            try:
                rc,out,err=cmd(args,seconds)
                if rc: return False,err or out or 'exit '+str(rc)
                return True,out
            except Exception as e:return False,str(e)
        for r in self.radios.values():
            p=r.get('process')
            if p and p.poll() is None:
                try:
                    p.terminate()
                    try:p.wait(3)
                    except subprocess.TimeoutExpired:p.kill();p.wait(3)
                except Exception as e:failures.append('Capture stop: '+str(e))
        for t in self.threads:
            try:t.join(40)
            except Exception as e:failures.append('Worker stop: '+str(e))
        if any(t.is_alive() for t in self.threads):
            self.state='FAILED'
            self.note('CLEANUP FAILED: worker still active; refusing concurrent radio restoration')
            print('Wi-Fi cleanup needs attention: worker still active',file=sys.stderr,flush=True)
            return
        for r in reversed(self.restores):
            name=r['name']
            try:
                root=Path('/sys/class/net')
                protected=root/'wlan0'/'phy80211'
                physical=root/name/'phy80211'
                if name not in DEVELOPMENT_RADIOS or not protected.exists() or not physical.exists() or physical.resolve()==protected.resolve() or physical.resolve().name!=r['phy']:
                    raise RuntimeError('Radio identity check failed; restoration refused for '+name)
                mode_ok=False
                for retry in range(3):
                    down,detail=attempt(['ip','link','set',name,'down'])
                    if down:
                        if r.get('direct_monitor'):
                            changed,detail=attempt(['iw','dev',name,'set','type',r['original_type']])
                        elif r.get('monitor'):
                            changed,detail=attempt(['iw','dev',r['monitor'],'del'])
                        else:changed=True
                        if changed:
                            checked,info=attempt(['iw','dev',name,'info'])
                            if checked and re.search(r'^\s*type '+re.escape(r.get('original_type','managed'))+r'\s*$',info,re.M):
                                mode_ok=True;break
                            detail='interface mode verification failed'
                    if retry<2:time.sleep(.3)
                if not mode_ok:raise RuntimeError('Restore '+name+': '+str(detail))
                ok,detail=attempt(['ip','link','set',name,'up' if r['was_up'] else 'down'])
                if not ok:failures.append('Restore '+name+' link state: '+str(detail))
                # Restore both yes and no explicitly; original ownership matters.
                ok,detail=attempt(['nmcli','device','set',name,'managed',r['managed']])
                if not ok:failures.append('Restore '+name+' NetworkManager: '+str(detail))
                if r['managed']=='yes' and re.fullmatch(r'[0-9a-fA-F-]{36}',r['uuid']):
                    ok,detail=attempt(['nmcli','connection','up','uuid',r['uuid'],'ifname',name],20)
                    if not ok:failures.append('Restore '+name+' connection: '+str(detail))
                # Check again after link/NetworkManager restoration, before clearing recovery state.
                verify_test_radio(name,r['phy'])
                ok,info=attempt(['iw','dev',name,'info'])
                if not ok or not re.search(r'^\s*type managed\s*$',info,re.M):
                    failures.append('Final mode check failed for '+name+'; recovery journal retained')
                ok,ownership=attempt(['nmcli','-g','GENERAL.NM-MANAGED','device','show',name])
                if not ok or ownership.strip()!=r['managed']:
                    failures.append('Final NetworkManager ownership check failed for '+name+'; recovery journal retained')
            except Exception as e:failures.append(str(e))
            finally:
                try:r['fd'].close()
                except Exception as e:failures.append('Radio lock close: '+str(e))
        if failures:
            self.state='FAILED'
            for detail in failures:self.note('CLEANUP FAILED: '+detail)
            print('Wi-Fi cleanup needs attention: '+'; '.join(failures),file=sys.stderr,flush=True)
        else:
            from cloverkit_radio_recovery import clear as _clear_radio_state
            _clear_radio_state(self.session)
            self.note('Cleanup verified: owned test interfaces restored; wlan0 untouched.')

    def run(self):
        try:
            self.setup()
            while not self.stop.wait(1):
                self.render()
                if self.radios and all(r.get('error') for r in self.radios.values()): raise RuntimeError('All capture streams failed')
        except KeyboardInterrupt: self.state='STOPPED'
        except Exception as e: self.state='FAILED'; self.note(str(e))
        finally:
            # A second Ctrl+C/Stop must not interrupt restoration or report writing.
            handlers={sig:signal.signal(sig,signal.SIG_IGN) for sig in (signal.SIGINT,signal.SIGTERM)}
            try:
                if not self.a.json: print('Stopping: restoring test adapters and saving report; please wait...',flush=True)
                self.cleanup(); self.render()
                final=self.folder/('wifi-passive-'+self.session+'.json')
                final.write_text(json.dumps(self.snapshot(),indent=2))
                os.chown(final,int(os.environ.get('SUDO_UID','0')),-1)
            finally:
                for sig,handler in handlers.items(): signal.signal(sig,handler)
        return 0 if self.state=='STOPPED' else 2

