from pathlib import Path
os.environ['PATH'] = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
ENV = dict(os.environ, LC_ALL='C')
FIELDS = ['frame.time_epoch','frame.len','wlan.bssid','wlan.ta','wlan.ra','wlan.fc.type','wlan.fc.subtype','wlan.fc.retry','radiotap.channel.freq','radiotap.dbm_antsignal','radiotap.dbm_antnoise','wlan.ssid','radiotap.datarate','wlan.qbss.cu','wlan.qbss.scount','wlan.fixed.reason_code']
REQUIRED = set(FIELDS[:8])
FIELDS += ['wlan.ht.info.chanwidth','wlan.ht.info.secchanoffset','wlan.vht.op.channelwidth','wlan.vht.op.channelcenter0','wlan.vht.op.channelcenter1']
