MAC = re.compile(r'^(?:[0-9a-f]{2}:){5}[0-9a-f]{2}$')

def cmd(args, seconds=10):
    try:
        p=subprocess.run(args, capture_output=True, text=True, timeout=seconds, env=ENV)
        return p.returncode,p.stdout,p.stderr.strip()
    except (OSError,subprocess.TimeoutExpired) as e: return 127,'',str(e)

def demand(args, seconds=10):
    rc,out,err=cmd(args, seconds)
    if rc: raise RuntimeError(' '.join(args)+': '+(err or out))
    return out

# CLOVER_AP_WIDTH_PARSE_V1
def value(s):
    import math
    try:
        raw=str(s).split(',')[0].strip()
        if raw.lower() in ('true','false'):
            return 1.0 if raw.lower()=='true' else 0.0
        number=float(int(raw,16)) if raw.lower().startswith(('0x','-0x','+0x')) else float(raw)
        return number if math.isfinite(number) else None
    except (ValueError,TypeError,AttributeError):return None


def ssid_name(raw):
    if not raw or raw in ('<MISSING>', '<missing>'): return 'Unknown/hidden'
    # tshark wlan.ssid is a byte field, emitted as hexadecimal.
    compact=raw.replace(':','')
    if len(compact)%2==0 and re.fullmatch(r'[0-9a-fA-F]+',compact):
        raw=bytes.fromhex(compact).decode('utf-8',errors='replace')
    return ''.join(c if c.isprintable() else '?' for c in raw)[:64] or 'Unknown/hidden'

def reading(number, unit=''):
    return 'unavailable' if number is None else str(number)+unit

def advertised_width(d):
    """Operation IEs only; never use capability bits or capture width as AP width."""
    ht=value(d.get('wlan.ht.info.chanwidth')); offset=value(d.get('wlan.ht.info.secchanoffset'))
    base='20 MHz' if offset==0 else '40 MHz' if offset in (1,3) and ht==1 else None
    vht=value(d.get('wlan.vht.op.channelwidth'))
    if vht==0 or vht is None: return base
    if vht==2: return '160 MHz'
    if vht==3: return '80+80 MHz'
    if vht==1:
        s0=value(d.get('wlan.vht.op.channelcenter0')); s1=value(d.get('wlan.vht.op.channelcenter1'))
        if s1==0: return '80 MHz'
        if s0 is not None and s1 is not None:
            if abs(s0-s1)==8: return '160 MHz'
            if abs(s0-s1)>16: return '80+80 MHz'
    return None

def unicast(mac):
    return bool(MAC.fullmatch(mac)) and not (int(mac[:2],16)&1)

def survey(text):
    result={}
    for block in re.split(r'Survey data from',text)[1:]:
        f=re.search(r'frequency:\s*(\d+)',block)
        if not f: continue
        row={}
        for key,pat in [('noise',r'noise:\s*(-?\d+)'),('active',r'channel active time:\s*(\d+)'),('busy',r'channel busy time:\s*(\d+)')]:
            m=re.search(pat,block)
            row[key]=int(m.group(1)) if m else None
        result[int(f.group(1))]=row
    return result

def busy_delta(before,after):
    if any(x.get(k) is None for x in (before,after) for k in ('active','busy')): return None
    active=after['active']-before['active']; busy=after['busy']-before['busy']
    return 100*busy/active if active>0 and 0<=busy<=active else None

def frequencies(text):
    return sorted({int(float(m.group(1))) for line in text.splitlines() if '(disabled)' not in line and (m:=re.search(r'\*\s+(\d+(?:\.\d+)?)\s+MHz\s+\[',line))})

def channel_plans(options):
    """Assign separate bands when capabilities allow; retain single-radio coverage."""
    if len(options)==1: return {options[0][0]: sorted(set(options[0][1]))}
    for low,high in (options, options[::-1]):
        low_plan=sorted({f for f in low[1] if 2400<=f<2500})
        high_plan=sorted({f for f in high[1] if 4900<=f<7125})
        if low_plan and high_plan:
            return {low[0]:low_plan,high[0]:high_plan}
    # Same-band radios share supported channels without discarding unique ones.
    a,b=options; shared=sorted(set(a[1]) & set(b[1]))
    plans={a[0]:sorted(set(a[1])-set(shared) | set(shared[::2])),
           b[0]:sorted(set(b[1])-set(shared) | set(shared[1::2]))}
    return {name: plan or sorted(set(freqs)) for name,freqs in options for plan in [plans[name]]}

def waterfall_frequencies(freqs,mode):
    bounds={'general':(2400,5925),'2.4':(2400,2500),'5':(4900,5925),'6':(5925,7125)}
    if not mode:return freqs
    lo,hi=bounds[mode]
    return [f for f in freqs if lo<=f<hi]

def waterfall_plans(options,mode):
    # The existing planner splits shared channels and preserves unique channels.
    return channel_plans(options)

def executive_summary(aps, clients, surveys, frames):
    measured=[a for a in aps if a['signal_dbm'] is not None]
    weak=[a for a in measured if a['signal_dbm']<-75]
    strong=[a for a in measured if a['signal_dbm']>=-67]
    eligible=[a for a in aps if a['recent_data_frames']>=100 and a['recent_retry_percent'] is not None]
    retries=[a for a in eligible if a['recent_retry_percent']>=20]
    busy=[r['busy_percent'] for r in surveys if r['busy_percent'] is not None]
    noise=[r['noise_dbm'] for r in surveys if r['noise_dbm'] is not None]
    snr=[a for a in aps if a['snr_db'] is not None and a['snr_db']<20]
    weak_clients=[c for c in clients if c['signal_dbm'] is not None and c['signal_dbm']<-75]
    if not frames: verdict='COLLECTING: no decoded traffic yet'
    elif retries or (busy and max(busy)>=70) or snr: verdict='ATTENTION: delivery/channel warning observed'
    elif weak and strong: verdict='MIXED COVERAGE: strong and weak signals nearby'
    elif weak: verdict='WEAK COVERAGE observed at this position'
    elif measured: verdict='No coverage warning in measured signals'
    else: verdict='INCONCLUSIVE: traffic seen, signal unavailable'
    rows=['Assessment: '+verdict]
    for band,lo,hi in [('2.4 GHz',2400,2500),('5 GHz',4900,5925),('6 GHz',5925,7125)]:
        group=[a for a in measured if lo<=a['frequency']<hi]
        if not group: continue
        signals=[a['signal_dbm'] for a in group]
        rows.append(f"{band}: {sum(v>=-67 for v in signals)} strong / {sum(v<-75 for v in signals)} weak; {min(signals):.0f} to {max(signals):.0f} dBm")
    if strong:
        best=max(strong,key=lambda a:a['signal_dbm'])
        rows.append(f"Strongest observed: {best['ssid'][:24]} ({best['signal_dbm']:.0f} dBm)")
    if retries: rows.append(f'Delivery: high captured retries on {len(retries)} AP/channel observations')
    elif eligible: rows.append(f'Delivery: no high retries in {len(eligible)} sufficiently sampled observations')
    else: rows.append('Delivery: not enough recent data to assess retries')
    if weak_clients: rows.append(f'Clients: {len(weak_clients)} weak signals received here; AP reception unknown')
    rows.append('Channel activity: '+(f'peak reported busy {max(busy):.0f}%; cause unknown' if busy else 'not measured by driver'))
    rows.append('Noise: '+(f'driver reports {min(noise)} to {max(noise)} dBm' if noise else 'unavailable; interference cannot be ruled out'))
    rows.append('Actual speed / latency / loss: not verified passively')
    if not frames: action='wait for a channel sweep; check capture notes if no frames'
    elif retries or (busy and max(busy)>=70) or snr: action='compare the flagged channels nearby; confirm with AP/client telemetry'
    elif weak: action='compare readings nearer the complaint location and AP'
    elif not eligible: action='keep collecting traffic; delivery assessment is incomplete'
    else: action='if complaints continue, check the affected client and upstream path'
    rows += ['Scope: all nearby APs, measured at BH; hopping misses traffic.']
    return rows

# CLOVERKIT_DEVELOPMENT_RADIOS_V1
DEVELOPMENT_RADIOS = ('wlan1', 'wlan2')

def verify_test_radio(name, expected_phy, root=Path('/sys/class/net')):
    from cloverkit_radio_identity import verify_usb
    verify_usb(name,root)
    if name not in DEVELOPMENT_RADIOS:
        raise RuntimeError('Only wlan1 and wlan2 may be used for development')
    protected = root/'wlan0'/'phy80211'
    physical = root/name/'phy80211'
    if not protected.exists() or not physical.exists():
        raise RuntimeError('Cannot verify protected/development radio identity')
    protected = protected.resolve(strict=True)
    physical = physical.resolve(strict=True)
    if physical == protected or physical.name != expected_phy:
        raise RuntimeError('Radio identity changed or shares wlan0; setup refused')
    interfaces = [p.name for p in root.iterdir()
                  if (p/'phy80211').exists() and
                  (p/'phy80211').resolve(strict=True) == physical]
    if interfaces != [name]:
        raise RuntimeError('Development radio has additional interfaces; setup refused')

def test_radios(root=Path('/sys/class/net')):
    from cloverkit_radio_identity import assert_layout
    assert_layout(root)
    protected = root/'wlan0'/'phy80211'
    if not protected.exists():
        raise RuntimeError('Cannot identify wlan0 protected radio; setup refused')
    seen = {protected.resolve(strict=True)}
    result = []
    for name in DEVELOPMENT_RADIOS:
        physical = root/name/'phy80211'
        if not physical.exists():
            continue
        physical = physical.resolve(strict=True)
        if physical in seen:
            continue
        seen.add(physical)
        result.append((name, physical.name))
    return result


# CLOVER_TSHARK_TARGETED_FIELDS_V1
def health_supported_fields():
    """Validate only requested fields against an empty radiotap capture."""
    import hashlib, struct, tempfile
    executable=Path('/usr/bin/tshark')
    st=executable.stat()
    key=hashlib.sha256(repr((st.st_size,st.st_mtime_ns,FIELDS)).encode()).hexdigest()
    cache=Path('/var/cache/cloverkit/wifi-health-fields.json')
    try:
        saved=json.loads(cache.read_text())
        supported=saved.get('fields',[])
        if saved.get('key')==key and isinstance(supported,list) and all(isinstance(f,str) and f in FIELDS for f in supported) and REQUIRED<=set(supported):
            return set(supported)
    except (OSError,ValueError,TypeError):pass
    pending=list(FIELDS)
    with tempfile.TemporaryDirectory(prefix='clover-fields-') as directory:
        capture=Path(directory)/'empty.pcap'
        capture.write_bytes(struct.pack('<IHHIIII',0xa1b2c3d4,2,4,0,0,65535,127))
        for attempt in range(3):
            argv=[str(executable),'-n','-r',str(capture),'-T','fields']
            for field in pending:argv.extend(['-e',field])
            try:
                result=subprocess.run(argv,stdout=subprocess.DEVNULL,stderr=subprocess.PIPE,text=True,timeout=60,env=ENV)
            except subprocess.TimeoutExpired:
                raise RuntimeError('TShark targeted field check timed out before radio capture started')
            if result.returncode==0:
                cache.parent.mkdir(parents=True,exist_ok=True)
                fd,tmp=tempfile.mkstemp(prefix='.health-fields-',dir=cache.parent)
                try:
                    with os.fdopen(fd,'w') as f:
                        json.dump({'key':key,'fields':pending},f);f.flush();os.fsync(f.fileno())
                    os.chmod(tmp,0o600);os.replace(tmp,cache)
                finally:Path(tmp).unlink(missing_ok=True)
                return set(pending)
            invalid={line.strip() for line in result.stderr.splitlines() if line.strip() in pending}
            if not invalid:
                raise RuntimeError('TShark field check failed: '+result.stderr.strip()[-800:])
            if invalid & REQUIRED:
                raise RuntimeError('Missing required tshark fields: '+', '.join(sorted(invalid & REQUIRED)))
            pending=[f for f in pending if f not in invalid]
    raise RuntimeError('Unable to validate optional TShark fields')


class Monitor:
    def __init__(self,a):
        self.a=a; self.stop=threading.Event(); self.lock=threading.RLock(); self.started=time.monotonic()
        self.aps={}; self.clients={}; self.radios={}; self.notes=[]; self.restores=[]; self.threads=[]
        self.fields=[]; self.state='STARTING'; self.samples=collections.deque(maxlen=600); self.total=0
        self.session=datetime.datetime.now().strftime('%Y%m%d-%H%M%S')+'-'+str(os.getpid())
        self.trend_history={}
        self.traffic_mix=collections.deque(maxlen=20000)
        self.channel_visits=collections.deque(maxlen=2000)
        self.folder=Path(a.output); self.folder.mkdir(parents=True,exist_ok=True)
        self.ap_inventory={}; self.inventory_signature=None
        self.reload_inventory()
    def reload_inventory(self):
        inventory=self.folder/'ap-inventory.json'
        signature=(inventory.stat().st_mtime_ns,inventory.stat().st_size) if inventory.exists() else None
        if signature==self.inventory_signature: return
        self.inventory_signature=signature; self.ap_inventory={}
        if signature is not None:
            try:
                records=json.loads(inventory.read_text())
                if not isinstance(records,dict): raise ValueError('expected BSSID mapping object')
                validated={}
                for address,record in records.items():
                    if not re.fullmatch(r'(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}',address): raise ValueError('invalid BSSID')
                    if not isinstance(record,dict) or not isinstance(record.get('id'),str) or not record['id'].strip(): raise ValueError('each BSSID needs a confirmed AP id')
                    validated[address.lower()]={k:record[k][:120] for k in ('id','name','radio') if isinstance(record.get(k),str)}
                self.ap_inventory=validated
            except (OSError,ValueError,TypeError) as e: self.note('AP inventory ignored: '+str(e))
    def note(self,msg):
        with self.lock: self.notes.append(msg); self.notes=self.notes[-30:]
    def ingest(self,line,radio):
        cells=line.rstrip('\n').split('\t')
        if len(cells)<8 or len(cells)>len(self.fields): return
        cells += [''] * (len(self.fields)-len(cells))
        d=dict(zip(self.fields,cells)); bssid=d.get('wlan.bssid','').lower(); ta=d.get('wlan.ta','').lower(); ra=d.get('wlan.ra','').lower()
        typ=value(d.get('wlan.fc.type')); sub=value(d.get('wlan.fc.subtype'))
        freq=value(d.get('radiotap.channel.freq')); sig=value(d.get('radiotap.dbm_antsignal')); noise=value(d.get('radiotap.dbm_antnoise'))
        now=time.monotonic(); length=value(d.get('frame.len')) or 0; retry=d.get('wlan.fc.retry') in ('1','True','true')
        with self.lock:
            self.total+=1
            self.traffic_mix.append((now,typ,sub,length))
            r=self.radios[radio]; r['frames']+=1; r['last_frame']=now
            r['window'].append((now,length))
            # Scheduling hint only: accept current-channel frames or unlabelled frames.
            # Late buffered frames labelled for a previous channel do not extend this visit.
            if freq is None or int(freq)==r.get('frequency'):
                r['visit_frames']=r.get('visit_frames',0)+1
            if freq is None:
                r['frames_without_channel']=r.get('frames_without_channel',0)+1
                return # Count activity, but never guess a frame's channel during hopping.
            if noise is not None and -130<=noise<=-20: r.setdefault('noise_window',collections.deque(maxlen=120)).append((now,noise))
            if not unicast(bssid): return
            key=(bssid,int(freq))
            if key not in self.aps:
                if len(self.aps)>=2000: self.note('AP capacity reached; oldest observations are evicted'); self.aps.pop(min(self.aps,key=lambda k:self.aps[k]['last']))
                self.aps[key]={'bssid':bssid,'frequency':int(freq),'ssid':'Unknown/hidden','first':now,'last':now,'ap_signal':collections.deque(maxlen=120),'snr':collections.deque(maxlen=120),'data':0,'retry':0,'down':0,'up':0,'events':0,'load':None,'load_time':None,'stations':None,'last_reason':None,'window':collections.deque(maxlen=10000)}
            ap=self.aps[key]; ap['last']=now
            if typ==0 and sub in (5,8) and ta==bssid:
                ap['beacons']=ap.get('beacons',0)+int(sub==8)
                ap['last_beacon']=now if sub==8 else ap.get('last_beacon')
                observed_width=advertised_width(d)
                if observed_width is not None:
                    ap['advertised_width']=observed_width
                    ap['width_seen']=now
                primary=value(d.get('wlan.ht.info.primarychannel'))
                if primary is not None and primary.is_integer() and 1<=primary<=233:
                    ap['advertised_primary_channel']=int(primary)
                    ap['primary_seen']=now
                device={key:''.join(ch for ch in d.get('wps.'+field,'') if ch.isprintable())[:120] for key,field in [('name','device_name'),('manufacturer','manufacturer'),('model','model_name'),('serial','serial_number')] if d.get('wps.'+field)}
                uuid=re.sub(r'[:\- ]','',d.get('wps.uuid_e','')).lower()
                if re.fullmatch(r'[0-9a-f]{32}',uuid) and uuid not in ('0'*32,'f'*32): device['uuid']=uuid
                if device: ap['advertised_device']=device;ap['device_seen']=now

                if d.get('wlan.ssid'): ap['ssid']=ssid_name(d['wlan.ssid'])
                load=value(d.get('wlan.qbss.cu')); stations=value(d.get('wlan.qbss.scount'))
                if load is not None and 0<=load<=255:
                    ap['load']=round(load*100/255,1); ap['load_time']=now
                    ap['stations']=int(stations) if stations is not None and 0<=stations<=65535 else None
            if ta==bssid and sig is not None:
                ap['ap_signal'].append((now,sig))
                if noise is not None and -130<=noise<=-20: ap['snr'].append((now,sig-noise))
            if typ==0 and sub in (10,12):
                ap['events']+=1; ap['last_reason']=value(d.get('wlan.fixed.reason_code'))
            if typ!=2: return
            to_ds=d.get('wlan.fc.tods'); from_ds=d.get('wlan.fc.fromds')
            # Confirm infrastructure direction using DS bits when the decoder supplies them.
            if to_ds and from_ds:
                direction='down' if to_ds in ('0','False','false') and from_ds in ('1','True','true') and ta==bssid else 'up' if to_ds in ('1','True','true') and from_ds in ('0','False','false') and ra==bssid else None
            else:
                direction='down' if ta==bssid else 'up' if ra==bssid else None
            ap['data']+=1; ap['retry']+=int(retry); ap['window'].append((now,length,int(retry),direction))
            if not direction: return # Ignore ambiguous mesh/WDS attribution.
            ap[direction]+=1
            client=ra if direction=='down' else ta
            if not unicast(client) or client==bssid: return
            ck=(bssid,client,int(freq))
            if ck not in self.clients:
                if len(self.clients)>=5000: self.clients.pop(min(self.clients,key=lambda k:self.clients[k]['last']))
                self.clients[ck]={'ap':bssid,'client':client,'frequency':int(freq),'last':now,'up':0,'down':0,'retry':0,'signal':collections.deque(maxlen=60),'window':collections.deque(maxlen=10000)}
            c=self.clients[ck]; c['last']=now; c[direction]+=1; c['retry']+=int(retry)
            c['window'].append((now,length,int(retry),direction))
            if direction=='up' and sig is not None: c['signal'].append((now,sig))
    def capture(self,name):
        r=self.radios[name]; args=['tshark','-n','-l','-i',r['monitor'],'-s','2048','-T','fields','-E','separator=/t','-E','occurrence=f']
        for field in self.fields: args+=['-e',field]
        # stderr is bounded by a drain thread; never leave a full stderr pipe blocking capture.
        try:
            p=subprocess.Popen(args,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,bufsize=1,env=ENV)
            r['process']=p
            if self.stop.is_set():
                p.terminate()
                try:p.wait(3)
                except subprocess.TimeoutExpired:p.kill();p.wait(3)
                return
            def errors():
                for line in p.stderr:
                    if line.strip(): r['capture_message']=line.strip()[:240]
            t=threading.Thread(target=errors,daemon=True); t.start()
            for line in p.stdout:
                if self.stop.is_set(): break
                self.ingest(line,name)
            if not self.stop.is_set(): r['error']='Capture exited: '+str(p.poll())+' '+r.get('capture_message','')
        except Exception as e: r['error']=str(e)
        finally:
            if r.get('process') and r['process'].poll() is None: r['process'].terminate()
    def hop(self,name,freqs,index,count):
        r=self.radios[name]; pos=index; active={}
        quiet=3; extended=max(10,self.a.dwell)
        while not self.stop.is_set():
            freq=freqs[pos%len(freqs)]; pos+=count
            rc,out,err=cmd(['iw','dev',r['monitor'],'set','freq',str(freq)])
            if rc: r['tune_error']=err; self.stop.wait(.5); continue
            with self.lock:
                r['tune_error']=None; r['frequency']=freq
                visit=(pos-count-index)//count
                r['sweep_number']=visit//len(freqs)+1
                r['sweep_position']=visit%len(freqs)+1
                r['sweep_channels']=len(freqs)
                target=self.a.dwell if visit<len(freqs) else extended if active.get(freq,False) else quiet
                r['sweep_nominal_seconds']=sum(extended if active.get(f,False) else self.a.dwell if visit<len(freqs) else quiet for f in freqs)
                r['sweep_max_seconds']=len(freqs)*extended
                r['dwell_target_seconds']=target; r['visit_frames']=0
                r['dwell_elapsed_seconds']=0
            start=time.monotonic()
            with self.lock: r['visit_started']=start
            info=cmd(['iw','dev',r['monitor'],'info'])[1]
            width=re.search(r'width:\s*(\d+)\s*MHz',info)
            with self.lock: r['capture_width_mhz']=int(width.group(1)) if width else None
            before=survey(cmd(['iw','dev',r['monitor'],'survey','dump'])[1]).get(freq,{})
            while not self.stop.is_set():
                elapsed=time.monotonic()-start
                with self.lock:
                    if r['visit_frames']>0: target=extended
                    r['dwell_target_seconds']=target
                    r['dwell_elapsed_seconds']=round(elapsed,1)
                if elapsed>=target: break
                self.stop.wait(min(.5,target-elapsed))
            duration=time.monotonic()-start
            with self.lock: active[freq]=r['visit_frames']>0
            after=survey(cmd(['iw','dev',r['monitor'],'survey','dump'])[1]).get(freq,{})
            row={'radio':name,'frequency':freq,'noise_dbm':after.get('noise'),'busy_percent':busy_delta(before,after),'observed_seconds':round(duration,2),'time':time.monotonic()}
            with self.lock:
                r['survey']=row; self.samples.append(row)
                self.channel_visits.append((name,freq,start,start+duration,r.get('capture_width_mhz')))
                r['visit_started']=None
    def setup(self):
