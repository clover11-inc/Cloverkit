#!/usr/bin/env python3

import argparse
import json
from pathlib import Path

REPORT = Path("/mnt/security/reports/latest.json")
SEV = ("CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO")


def emit(event, **data):
    row = {"event": event}
    row.update(data)
    print(json.dumps(row, separators=(",", ":")))


def counts(findings):
    return {
        sev: sum(
            1 for f in findings
            if f.get("severity") == sev
        )
        for sev in SEV
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--host")
    args = parser.parse_args()

    with REPORT.open("r", encoding="utf-8") as fh:
        report = json.load(fh)

    hosts = report.get("hosts", [])
    ble = report.get("ble_devices", [])
    wifi = report.get("wifi_devices", [])

    if args.host:
        host = next(
            (h for h in hosts if h.get("ip") == args.host),
            None
        )

        if not host:
            emit("error", message="host not found", host=args.host)
            return 2

        findings = host.get("findings", [])

        emit(
            "host",
            ip=host.get("ip"),
            hostname=host.get("hostname"),
            mac=host.get("mac"),
            vendor=host.get("vendor"),
            services=host.get("services", []),
            counts=counts(findings),
            findings=findings,
        )
        return 0

    all_findings = [
        f
        for host in hosts
        for f in host.get("findings", [])
    ]

    all_findings += [f for device in ble+wifi for f in device.get('findings',[])]
    emit(
        "scan",
        timestamp=report.get("timestamp"),
        target=report.get("target"),
        network_devices=len(hosts),
        ble_devices=len(ble),
        wifi_devices=len(wifi),
        coverage=report.get("coverage",{}),
        counts=counts(all_findings),
    )

    for host in hosts:
        findings = host.get("findings", [])

        if not findings:
            continue

        rank = {
            sev: i
            for i, sev in enumerate(SEV)
        }

        actionable = [
            f for f in findings
            if f.get("confidence") != "POSSIBLE"
        ]

        pool = actionable or findings

        top = min(
            pool,
            key=lambda f: (
                rank.get(f.get("severity"), 99),
                -float(f.get("cvss") or 0),
            ),
        )

        emit(
            "attention",
            ip=host.get("ip"),
            hostname=host.get("hostname"),
            counts=counts(findings),
            top_severity=top.get("severity"),
            top_code=top.get("code"),
            top_title=top.get("title"),
            top_cve=top.get("cve"),
            top_cvss=top.get("cvss"),
            top_action=top.get("action"),
            top_validation=top.get("validation", {}),
        )
    rank={sev:i for i,sev in enumerate(SEV)}
    for transport,devices in (('Wi-Fi',wifi),('BLE',ble)):
        for device in devices:
            findings=device.get('findings',[])
            if not findings:continue
            top=min(findings,key=lambda f:rank.get(f.get('severity'),99))
            emit('attention',transport=transport,address=device.get('bssid') or device.get('mac'),hostname=device.get('ssid') or device.get('name'),counts=counts(findings),top_severity=top.get('severity'),top_code=top.get('code'),top_title=top.get('title'),top_action=top.get('action'),top_validation=top.get('validation'))


if __name__ == "__main__":
    raise SystemExit(main())
