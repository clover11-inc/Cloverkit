#!/bin/bash

TARGET="$1"

if [ -z "$TARGET" ]; then
    echo "Usage: host-profile <IP>"
    exit 1
fi

if ! [[ "$TARGET" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo "Invalid IP"
    exit 1
fi

TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

echo "$TARGET"
echo "STATE IDENTIFYING"

# Basic identity
NAME=$(getent hosts "$TARGET" 2>/dev/null | awk '{print $2; exit}')
[ -n "$NAME" ] && echo "NAME $NAME"

MAC=$(ip neigh show "$TARGET" 2>/dev/null | awk '/lladdr/{print $5; exit}')
[ -n "$MAC" ] && echo "MAC  $MAC"

echo "STATE SCANNING"
echo "Scanning..."

# Useful, reasonably quick profile.
# - common 1000 TCP ports
# - service/version detection
# - light OS fingerprint attempt
sudo -n nmap \
    -Pn \
    --top-ports 1000 \
    --open \
    -sT \
    -sV \
    --version-light \
    -O \
    --osscan-limit \
    --max-retries 1 \
    --host-timeout 45s \
    "$TARGET" \
    -oN "$TMP" \
    >/dev/null 2>&1

if ! grep -qE '^[0-9]+/tcp[[:space:]]+open' "$TMP"; then
    echo "No common TCP ports open"
else
    echo

    awk '
    /^[0-9]+\/tcp[[:space:]]+open/ {
        split($1,a,"/")
        port=a[1]
        svc=$3

        version=""
        for(i=4;i<=NF;i++) {
            if(version!="") version=version " "
            version=version $i
        }

        if(version!="")
            printf "%-5s %-12s %s\n", port, svc, version
        else
            printf "%-5s %s\n", port, svc
    }
    ' "$TMP"
fi

echo "STATE ANALYZING"

# OS clue if nmap got one
OS=$(awk -F': ' '
/^OS details:/ {
    print $2
    exit
}
/^Aggressive OS guesses:/ {
    print $2
    exit
}
' "$TMP")

if [ -n "$OS" ]; then
    echo
    echo "OS ${OS:0:42}"
fi

# Lightweight conditional clues from discovered ports
OPENPORTS=$(awk '
/^[0-9]+\/tcp[[:space:]]+open/ {
    split($1,a,"/")
    print a[1]
}
' "$TMP")

has_port() {
    echo "$OPENPORTS" | grep -qx "$1"
}

# HTTP title / server header
if has_port 80; then
    TITLE=$(curl -L -m 3 -s "http://$TARGET/" 2>/dev/null |
        tr '\n' ' ' |
        sed -n 's:.*<title[^>]*>\([^<]*\)</title>.*:\1:Ip' |
        head -1)

    SERVER=$(curl -I -m 3 -s "http://$TARGET/" 2>/dev/null |
        awk -F': ' 'tolower($1)=="server"{gsub("\r","",$2); print $2; exit}')

    [ -n "$TITLE" ] && echo "WEB  ${TITLE:0:38}"
    [ -n "$SERVER" ] && echo "HTTP ${SERVER:0:38}"
fi

# HTTPS certificate name
if has_port 443; then
    TLS=$(
        timeout 4 openssl s_client \
            -connect "$TARGET:443" \
            -servername "$TARGET" \
            </dev/null 2>/dev/null |
        openssl x509 -noout -subject 2>/dev/null |
        sed -n 's/.*CN[[:space:]]*=[[:space:]]*//p' |
        head -1
    )

    [ -n "$TLS" ] && echo "TLS  ${TLS:0:38}"
fi

# SSH banner
if has_port 22; then
    SSHB=$(
        timeout 3 bash -c \
            "exec 3<>/dev/tcp/$TARGET/22; head -1 <&3" \
            2>/dev/null |
        tr -d '\r\n'
    )

    [ -n "$SSHB" ] && echo "SSH  ${SSHB:0:38}"
fi

echo
echo "STATE COMPLETE"
echo "Done"
