#!/usr/bin/env python3

from pathlib import Path


ROOT = Path("/mnt/scripts")

count = 0
already = 0
empty = 0


for path in sorted(ROOT.glob("TARGET-*.sh")):

    try:
        text = path.read_text(
            encoding="utf-8",
        )
    except Exception:
        continue

    if not text.strip():
        empty += 1
        continue

    if "BH_LCD_DISPATCH_V1" in text:
        already += 1
        continue

    lines = text.splitlines()

    if not lines:
        empty += 1
        continue

    if lines[0].startswith("#!"):
        body = lines[1:]
    else:
        body = lines

    wrapped = [
        "#!/bin/bash",
        "# BH_LCD_DISPATCH_V1",
        'if [ "${BH_LCD_DISPATCHED:-0}" != "1" ]; then',
        '    exec /usr/local/bin/lcd-run "$0" "$@"',
        "fi",
        "",
        *body,
        "",
    ]

    try:

        path.write_text(
            "\n".join(wrapped),
            encoding="utf-8",
        )

        path.chmod(0o755)

        count += 1

    except Exception:
        pass


print(
    f"TARGET WRAP: patched={count} "
    f"already={already} empty={empty}"
)
