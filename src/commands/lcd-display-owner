#!/usr/bin/env python3

import fcntl
import os
import sys
import time


TTY = "/dev/tty1"
FB = "/dev/fb0"

KDSETMODE = 0x4B3A
KD_TEXT = 0x00
KD_GRAPHICS = 0x01


def open_tty():
    return os.open(
        TTY,
        os.O_RDWR | os.O_NOCTTY,
    )


def clear_fb():
    try:
        fd = os.open(FB, os.O_WRONLY)

        try:
            # Current LCD is 480x480x32bpp.
            # Writing black over the whole visible frame prevents
            # old GUI pixels surviving a mode transition.
            remaining = 480 * 480 * 4
            block = b"\x00" * 65536

            while remaining > 0:
                n = min(remaining, len(block))
                os.write(fd, block[:n])
                remaining -= n
        finally:
            os.close(fd)

    except OSError:
        pass


def graphical():
    fd = open_tty()

    try:
        # Hide cursor before fbcon stops drawing.
        try:
            os.write(fd, b"\033[?25l")
        except OSError:
            pass

        fcntl.ioctl(
            fd,
            KDSETMODE,
            KD_GRAPHICS,
        )

    finally:
        os.close(fd)

    clear_fb()


def text():
    # Remove the last graphical frame first.
    clear_fb()

    fd = open_tty()

    try:
        fcntl.ioctl(
            fd,
            KDSETMODE,
            KD_TEXT,
        )

        time.sleep(0.05)

        # Clear anything tty1 accumulated while hidden.
        os.write(
            fd,
            b"\033[0m"
            b"\033[2J"
            b"\033[H"
            b"\033[?25h",
        )

    finally:
        os.close(fd)


if len(sys.argv) != 2:
    print(
        "usage: lcd-display-owner "
        "graphical|text",
        file=sys.stderr,
    )
    raise SystemExit(2)


mode = sys.argv[1].lower()

if mode == "graphical":
    graphical()

elif mode in ("text", "cli"):
    text()

else:
    print(
        f"unknown mode: {mode}",
        file=sys.stderr,
    )
    raise SystemExit(2)
