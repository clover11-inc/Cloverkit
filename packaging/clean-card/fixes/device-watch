def mac_prefix(bssid):
    """
    Conservative local BSSID-family representation.

    Uses first 5 octets rather than merely the OUI because
    wifi-scan already groups nearby allocated BSSIDs.
    """

    parts = bssid.upper().split(":")

    if len(parts) != 6:
        return ""

    return ":".join(parts[:5])


def run_wifi_scan():

    # Device Watch NEVER uses wlan0.
    if not any(wifi_interface_exists(name) for name in ("wlan1","wlan2")):
        return {
            "status": "unavailable",
            "reason": "wlan1 not available",
        }

    wifi_scan = command_path(
        "cloverkit-device-watch-wifi",
        ("/usr/local/bin/cloverkit-device-watch-wifi",),
    )

    if not wifi_scan:
        return {
            "status": "unavailable",
            "reason": "Device watch Wi-Fi scanner not installed",
        }

    best = None
    last_scan_error = "Wi-Fi scan produced no usable manifest"

    # Normal case is one scan.
    # Retry once only when the result is suspiciously small.
    for attempt in range(2):

        try:
            WIFI_MANIFEST.unlink(
                missing_ok=True
            )
        except Exception:
            pass

        # Run wifi-scan asynchronously so the graphical Device Watch
        # display remains visibly alive during the blocking kernel scan
        # and optional AP-name enrichment.
        started = time.monotonic()

        p = subprocess.Popen(
            [wifi_scan],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )

        while p.poll() is None:
            elapsed = int(
                time.monotonic() - started
            )

            live_event(
                "wifi_progress",
                phase="SCANNING WIFI",
                interface="USB Wi-Fi",
                attempt=attempt + 1,
                elapsed=elapsed,
            )

            time.sleep(1.0)

        _, stderr = p.communicate()

        live_event(
            "wifi_progress",
            phase="SCANNING WIFI",
            interface="USB Wi-Fi",
            attempt=attempt + 1,
            elapsed=int(
                time.monotonic() - started
            ),
        )

        if p.returncode != 0:
            last_scan_error = stderr.strip()[-500:] or "Wi-Fi scan failed (exit " + str(p.returncode) + ")"
            continue

        if not WIFI_MANIFEST.exists():
            continue

        try:
            with WIFI_MANIFEST.open(
                encoding="utf-8"
            ) as f:
                data = json.load(f)

        except Exception:
            continue

        interface = data.get(
            "interface",
            "",
        )

        # Absolute protection for management radio.
        if interface == "wlan0":
            return {
                "status": "blocked",
                "reason": "refusing wlan0 manifest",
            }

        if interface not in ("wlan1","wlan2"):
            continue

        result = {
            "status": "ok",
            "interface": interface,
            "rows": data.get("rows", []),
            "groups": data.get("groups", []),
            "attempts": attempt + 1,
            "interfaces": data.get("interfaces", [interface]),
            "coverage": data.get("coverage", []),
            "coverage_notes": data.get("coverage_notes", []),
        }

        if (
            best is None
            or len(result["rows"])
            > len(best["rows"])
        ):
            best = result

        # Healthy enough population:
        # don't waste time rescanning.
        if (
            len(result["rows"]) >= 10
            and len(result["groups"]) >= 4
        ):
            break

    if best is None:
        return {
            "status": "failed",
            "reason": last_scan_error,
        }

    # Mark a very small sample so anomaly scoring can
    # deliberately avoid drawing conclusions from it.
    best["sample_ok"] = (
        len(best["rows"]) >= 10
        and len(best["groups"]) >= 4
    )

    return best


def build_wifi_population(rows):

    by_ssid = defaultdict(list)

    for row in rows:

        ssid = str(
            row.get("ssid", "")
        ).strip()

        bssid = str(
            row.get("bssid", "")
        ).upper().strip()

        if not ssid or not bssid:
            continue

        by_ssid[ssid].append(row)

    return by_ssid


def group_companions(groups):

    result = {}

    for group in groups:

        members = group.get(
            "members",
            [],
        )

        ssids = {
            str(m.get("ssid", "")).strip()
            for m in members
            if str(m.get("ssid", "")).strip()
        }

        for member in members:

            bssid = str(
                member.get("bssid", "")
            ).upper().strip()

            if bssid:
                result[bssid] = (
                    ssids - {
                        str(
                            member.get(
                                "ssid",
                                "",
                            )
                        ).strip()
                    }
                )

    return result


def analyse_wifi(rows, groups):

    findings = []

    populations = build_wifi_population(
        rows
    )

    companions = group_companions(
        groups
    )

    # --------------------------------------------------------
    # Learn companion relationships from physical AP groups.
    #
    # Example:
    #   Campus-Example + Guest-Example
    #
    # We only call a companion "expected" when it appears
    # across multiple physical groups.
    # --------------------------------------------------------

    companion_expectation = defaultdict(
        Counter
    )

    groups_containing_ssid = Counter()

    for group in groups:

        members = group.get(
            "members",
            [],
        )

        ssids = {
            str(
                m.get("ssid", "")
            ).strip()
            for m in members
            if str(
                m.get("ssid", "")
            ).strip()
        }

        for ssid in ssids:

            groups_containing_ssid[
                ssid
            ] += 1

            for other in (
                ssids - {ssid}
            ):
                companion_expectation[
                    ssid
                ][other] += 1


    # --------------------------------------------------------
    # Examine each SSID population.
    # --------------------------------------------------------

    for ssid, peers in populations.items():

        if len(peers) < 2:
            continue


        security_counts = Counter(
            str(
                p.get(
                    "security",
                    "UNKNOWN",
                )
            )
            for p in peers
        )


        dominant_security = (
            security_counts.most_common(1)[0][0]
            if security_counts
            else None
        )


        # Require at least two peers agreeing before we
        # consider this a baseline.
        dominant_security_count = (
            security_counts[
                dominant_security
            ]
            if dominant_security
            else 0
        )


        signals = []

        for peer in peers:

            try:
                signals.append(
                    float(
                        peer.get("sig")
                    )
                )
            except (
                TypeError,
                ValueError,
            ):
                pass


        median_signal = (
            statistics.median(
                signals
            )
            if signals
            else None
        )


        # Companion must occur on at least two physical APs.
        expected_companions = {
            other
            for other, count
            in companion_expectation[
                ssid
            ].items()
            if count >= 2
        }


        for peer in peers:

            score = 0
            reasons = []


            bssid = str(
                peer.get(
                    "bssid",
                    "",
                )
            ).upper()


            security = str(
                peer.get(
                    "security",
                    "UNKNOWN",
                )
            )


            # ------------------------------------------------
            # SECURITY MISMATCH
            #
            # This is strong evidence because an impersonating
            # SSID may reproduce the name but expose different
            # RSN/security behaviour.
            # ------------------------------------------------

            if (
                dominant_security
                and dominant_security_count >= 2
                and security
                != dominant_security
            ):

                score += 4

                reasons.append(
                    "security differs from established peers"
                )


            # ------------------------------------------------
            # COMPANION SSID
            #
            # Supporting evidence only.
            #
            # Missing a companion can happen legitimately due
            # to scan timing/range.
            # ------------------------------------------------

            observed_companions = companions.get(
                bssid,
                set(),
            )


            missing = (
                expected_companions
                - observed_companions
            )


            if missing:

                score += 1

                reasons.append(
                    "expected companion SSID absent"
                )


            # ------------------------------------------------
            # SIGNAL OUTLIER
            #
            # Weak supporting evidence only.
            # ------------------------------------------------

            try:
                sig = float(
                    peer.get("sig")
                )
            except (
                TypeError,
                ValueError,
            ):
                sig = None


            if (
                sig is not None
                and median_signal
                is not None
                and sig >= -40
                and (
                    sig - median_signal
                ) >= 25
            ):

                score += 1

                reasons.append(
                    "unusually strong vs peers"
                )


            # One weak clue is not worth displaying.
            if score < 2:
                continue


            if score >= 6:

                confidence = "LIKELY"
                category = "WIFI ROGUE?"

            elif score >= 4:

                confidence = "POSSIBLE"
                category = "WIFI ROGUE?"

            else:

                confidence = "INFO"
                category = "WIFI ANOMALY"


            findings.append(
                {
                    "category": category,
                    "confidence": confidence,
                    "ssid": ssid,
                    "bssid": bssid,
                    "security": security,
                    "signal": sig,
                    "score": score,
                    "reasons": reasons,
                }
            )


    findings.sort(
        key=lambda x: (
            x["score"],
            x["signal"]
            if x["signal"]
            is not None
            else -999,
        ),
        reverse=True,
    )

    return findings


