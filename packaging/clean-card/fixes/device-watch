_live_output_times = {}

def progress_bar(current, total, label):
    """
    Clean single-line progress renderer.

    Uses a full line clear before every redraw so stale
    characters such as the old done6/done7 bug cannot remain.
    """

    total = max(float(total or 1), 1.0)
    current = max(0.0, min(float(current), total))

    width = 20
    filled = int(
        round(
            width * current / total
        )
    )

    filled = max(
        0,
        min(width, filled),
    )

    bar = (
        "█" * filled
        + "░" * (width - filled)
    )

    done = current >= total

    line = (
        f"{label:<18}"
        f"[{bar}]  "
        + ("done" if done else "")
    )

    if sys.stdout.isatty():
        sys.stdout.write(
            "\r\033[2K" + line
        )
        sys.stdout.flush()

        if done:
            sys.stdout.write("\n")
            sys.stdout.flush()

    else:
        now=time.monotonic()
        if done or current==0 or now-_live_output_times.get(('progress',label),-999)>=1:
            _live_output_times[('progress',label)]=now
            print(f'{label}: {int(current)}/{int(total)}'+(' complete' if done else 's' if label=='Scanning BLE' else ''))


def live_event(event, **fields):
    """
    Lightweight machine-readable event stream for the graphical
    Device Watch renderer.

    Normal CLI output remains unchanged and authoritative.
    """

    if os.environ.get("BH_LCD_MODE") != "graphical":
        if event=='stage':
            print('Stage: '+str(fields.get('phase','Working'))+((' · '+str(fields['adapter'])) if fields.get('adapter') else ''))
        elif event=='ble_device' and fields.get('category'):
            key=('device',fields.get('address'));now=time.monotonic()
            if now-_live_output_times.get(key,-999)>=1:
                _live_output_times[key]=now
                signal=fields.get('rssi');signal=f'{signal}dBm' if signal is not None else 'signal pending'
                print(f"LIVE {fields['category']} {fields.get('name') or fields.get('address')} · {signal} · {fields.get('seen',0)} BLE seen")
        return

    payload = {
        "event": event,
        **fields,
    }

    print(
        "DEVICE_WATCH_JSON "
        + json.dumps(
            payload,
            separators=(",", ":"),
        ),
        flush=True,
    )


def run(*args):
    return subprocess.run(
        args,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )


def command_path(name, fallbacks=()):
    for path in fallbacks:
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path

    from shutil import which
    return which(name)


def service_active():
    return (
        run(
            "systemctl",
            "is-active",
            "--quiet",
            "bluetooth",
        ).returncode == 0
    )


def bluetooth_blocked():
    rfkill = command_path(
        "rfkill",
        ("/usr/sbin/rfkill", "/sbin/rfkill"),
    )

    if not rfkill:
        return False

    p = run(
        rfkill,
        "list",
        "bluetooth",
    )

    return "Soft blocked: yes" in p.stdout


def adapter_exists(adapter):
    return os.path.exists(
        f"/sys/class/bluetooth/{adapter}"
    )


def wifi_interface_exists(interface):
    return os.path.exists(
        f"/sys/class/net/{interface}"
    )


