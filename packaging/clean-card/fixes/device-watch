def generate_ble_targets(matches, directory, refresh=True):
    import re,shlex
    directory=Path(directory)
    if not refresh:
        print('Prior BLE targets retained; this run supplied no fresh BLE observations.',flush=True)
        return []
    def safe(value):
        return re.sub(r'[^A-Z0-9_-]+','-',str(value or '').upper()).strip('-')[:28] or 'DEVICE'
    generated=[]
    eligible=[item for item in matches if item.get('category') not in ('FIND-MY','APPLE NEARBY')]
    priority={'HIGH':0,'LIKELY':1,'POSSIBLE':2,'INFO':3}
    eligible.sort(key=lambda item:(priority.get(item.get('confidence'),9),-(item.get('best_rssi') if item.get('best_rssi') is not None else -999)))
    selected=eligible[:12]
    if len(eligible)>12: print(f'BLE targets: 12 selected of {len(eligible)} classified foreground observations; confidence then signal.',flush=True)
    for item in selected:
        confidence=str(item.get('confidence','')).upper()
        if confidence not in ('HIGH','LIKELY','POSSIBLE','INFO'): continue
        rec=item['record'];address=str(rec.get('address','')).upper()
        if not re.fullmatch(r'(?:[0-9A-F]{2}:){5}[0-9A-F]{2}',address): continue
        category=str(item.get('category') or 'BLE')
        identity=safe(rec.get('name'))+'-' if rec.get('name') else ''
        filename=f"TARGET-BLE-{confidence}-{safe(category)}-{identity}{address.replace(':','')}.sh"
        command=['sudo','-n','/usr/local/bin/device-track',address]
        if category in ('FLIPPER','SMARTTAG'): command+=['--fingerprint',category.lower()]
        lines=['#!/bin/bash',"printf '%s\n' "+' '.join(shlex.quote(str(x)) for x in ('BLE TARGET',category+' '+confidence,rec.get('name') or address,address,'Classification is inferred from advertisements.')),
               'exec '+shlex.join(command),'']
        path=directory/filename
        path.write_text('\n'.join(lines),encoding='utf-8');path.chmod(0o755)
        generated.append(filename)
    # Only remove old generated targets after all current replacements are written.
    for old in directory.glob('TARGET-BLE-*.sh'):
        if old.name not in generated: old.unlink()
    return generated

def main():

    parser = argparse.ArgumentParser(
        prog="device-watch"
    )

    parser.add_argument(
        "seconds",
        nargs="?",
        type=int,
        default=20,
    )

    parser.add_argument(
        "--radio",
        choices=("hci0", "hci1"),
    )

    parser.add_argument(
        "--no-wifi",
        action="store_true",
        help="BLE only",
    )

    parser.add_argument(
        "--verbose",
        action="store_true",
        help="show full detection evidence",
    )

    parser.add_argument(
        "--details",
        action="store_true",
        help=(
            "show full passive BLE and Wi-Fi "
            "observation details"
        ),
    )

    parser.add_argument(
        "--show",
        metavar="MATCH",
        help=(
            "show passive details matching a name, "
            "category, MAC, BSSID or SSID"
        ),
    )

    args = parser.parse_args()

    duration = max(
        5,
        min(args.seconds, 120),
    )

    if os.geteuid() != 0:
        os.execvp(
            "sudo",
            [
                "sudo",
                "-n",
                "/usr/local/bin/device-watch",
            ] + sys.argv[1:],
        )

    # --------------------------------------------------------
    # BLE setup
    # Prevent repeated Device Watch runs restoring each other's Bluetooth state.
    import fcntl
    lock_directory=Path('/run/cloverkit');lock_directory.mkdir(mode=0o755,exist_ok=True)
    scan_lock=open(lock_directory/'device-watch.lock','a')
    try: fcntl.flock(scan_lock.fileno(),fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:
        print('Device Watch is already running. Stop it or wait before retrying.',flush=True)
        return 2
    # --------------------------------------------------------

    try:
        bt_adapter = select_bt_adapter(
            args.radio
        )

    except RuntimeError as error:
        bt_adapter = None
        adapter_error = str(error)

    radio_type = (
        "USB"
        if bt_adapter == "hci1"
        else "ONBOARD"
    )

    was_active = service_active()
    was_blocked = bluetooth_blocked()

    ble_devices = {}
    ble_error = None if bt_adapter else adapter_error

    try:

        if bt_adapter:

            subprocess.run(
                [
                    "systemctl",
                    "start",
                    "bluetooth",
                ],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

            rfkill = command_path(
                "rfkill",
                (
                    "/usr/sbin/rfkill",
                    "/sbin/rfkill",
                ),
            )

            if rfkill:

                subprocess.run(
                    [
                        rfkill,
                        "unblock",
                        "bluetooth",
                    ],
                    check=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )

            live_event(
                "stage",
                phase="SCANNING BLE",
                adapter=bt_adapter,
                duration=duration,
            )

            from cloverkit_ble_ready import scan_ready, usb_adapter
            bt_adapter, ble_devices = asyncio.run(
                scan_ready(bt_adapter, duration, scan_ble, progress=progress_bar,
                           explicit=bool(args.radio), event=live_event)
            )
            radio_type = "USB" if usb_adapter(bt_adapter) else "ONBOARD"

            live_event(
                "stage",
                phase="ANALYSING BLE",
                adapter=bt_adapter,
                seen=len(ble_devices),
            )

    except Exception as e:
        ble_error = type(e).__name__ + ': ' + str(e)
        print('BLE scan failed: '+ble_error,flush=True)
        live_event('stage',phase='BLE FAILED',adapter=bt_adapter,error=ble_error)

    finally:

        rfkill = command_path(
            "rfkill",
            (
                "/usr/sbin/rfkill",
                "/sbin/rfkill",
            ),
        )

        if was_blocked and rfkill:

            subprocess.run(
                [
                    rfkill,
                    "block",
                    "bluetooth",
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

        if not was_active:

            subprocess.run(
                [
                    "systemctl",
                    "stop",
                    "bluetooth",
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

    # --------------------------------------------------------
    # BLE classification
    # --------------------------------------------------------

    ble_matches = []

    ble_records = list(
        ble_devices.values()
    )

    analysis_total = max(
        1,
        len(ble_records),
    )

    if ble_records:
        progress_bar(
            0,
            analysis_total,
            "Analysing BLE",
        )

    for analysis_index, rec in enumerate(
        ble_records,
        1,
    ):

        result = classify_ble(rec)

        if not result:
            progress_bar(
                analysis_index,
                analysis_total,
                "Analysing BLE",
            )
            continue

        category, confidence, reason = result

        rssis = rec["rssis"]

        last_rssi = (
            rssis[-1]
            if rssis
            else None
        )

        best_rssi = (
            max(rssis)
            if rssis
            else None
        )

        ble_matches.append(
            {
                "record": rec,
                "category": category,
                "confidence": confidence,
                "reason": reason,
                "last_rssi": last_rssi,
                "best_rssi": best_rssi,
            }
        )

        progress_bar(
            analysis_index,
            analysis_total,
            "Analysing BLE",
        )

    # --------------------------------------------------------
    # Wi-Fi
    # --------------------------------------------------------

    if args.no_wifi:
        wifi_result = {
            "status": "disabled",
            "reason": "--no-wifi",
        }

    else:
        progress_bar(
            0,
            1,
            "Scanning WiFi",
        )

        live_event(
            "stage",
            phase="SCANNING WIFI",
            interface="wlan1",
        )

        wifi_result = run_wifi_scan()

        if wifi_result.get("status") == "ok":
            live_event(
                "wifi_result",
                phase="ANALYSING WIFI",
                interface=wifi_result.get(
                    "interface",
                    "wlan1",
                ),
                bssids=len(
                    wifi_result.get(
                        "rows",
                        [],
                    )
                ),
                aps=len(
                    wifi_result.get(
                        "groups",
                        [],
                    )
                ),
            )
        else:
            live_event(
                "stage",
                phase="WIFI UNAVAILABLE",
                interface="wlan1",
            )

        progress_bar(
            1,
            1,
            "Scanning WiFi",
        )

    # CLOVERKIT_ROADMAP_V1
    sys.path.insert(0,'/usr/local/lib/bh-interactive')
    from cloverkit_device_history import record as _record_history
    def record_history_after_summary():
        print('',flush=True)
        try:_record_history(ble_devices,wifi_result,ble_complete=not bool(ble_error) and bool(ble_devices))
        except (OSError,ValueError,TypeError) as error:print('Device history unavailable: '+str(error),flush=True)
    wifi_findings = []

    if wifi_result.get("status") == "ok":

        progress_bar(
            0,
            1,
            "Analysing WiFi",
        )

        if wifi_result.get("sample_ok", True):

            wifi_findings = analyse_wifi(
                wifi_result["rows"],
                wifi_result["groups"],
            )

        else:

            wifi_findings = []

        progress_bar(
            1,
            1,
            "Analysing WiFi",
        )

    # --------------------------------------------------------
    # Totals
    # --------------------------------------------------------

    counts = defaultdict(int)

    for item in ble_matches:
        counts[
            item["confidence"]
        ] += 1

    for item in wifi_findings:
        counts[
            item["confidence"]
        ] += 1

    total_matches = (
        len(ble_matches)
        + len(wifi_findings)
    )

    # --------------------------------------------------------
    # All classified observations receive tracking targets, including INFO.
    target_dir=Path('/mnt/scripts')
    created_ble_targets=generate_ble_targets(ble_matches,target_dir,refresh=not bool(ble_error) and bool(ble_devices))

    # --------------------------------------------------------
    # Output
    # --------------------------------------------------------

    show_query = (
        str(args.show or "")
        .strip()
        .lower()
    )

    details = (
        args.verbose
        or args.details
        or bool(show_query)
    )

    # Preserve the existing variable for compact/background
    # presentation behaviour.
    verbose = details

    # --------------------------------------------------------
    # Helpers used only for presentation.
    # --------------------------------------------------------

    def short_uuid(uuid):
        u = uuid.lower()

        if u.startswith("0000") and len(u) >= 8:
            return u[4:8].upper()

        return u.split("-")[0].upper()


    def ble_identity(item):

        rec = item["record"]

        if rec["name"]:
            return rec["name"]

        return rec["address"]


    def rssi_text(item):

        value = item["last_rssi"]

        if value is None:
            value = item["best_rssi"]

        if value is None:
            return ""

        return (
            f"{value}dBm "
            f"{signal_label(value)}"
        )


    def compact_evidence(item):

        rec = item["record"]
        category = item["category"]

        if category == "FLIPPER":

            matched = (
                rec["uuids"]
                & FLIPPER_UUIDS
            )

            if matched:
                values = ",".join(
                    short_uuid(x)
                    for x in sorted(matched)
                )

                return f"UUID {values}"


        if category == "SMARTTAG":
            return "FD5A service"

        if category == "TILE":
            return "FEED service"

        if category == "DRONE-ID":
            return "Remote ID"

        if category == "SKIMMER?":
            return "HC serial-module signature"

        return item["reason"]


    # --------------------------------------------------------
    # Sort BLE findings.
    # --------------------------------------------------------

    priority = {
        "HIGH": 0,
        "LIKELY": 1,
        "POSSIBLE": 2,
        "INFO": 3,
    }

    ble_matches.sort(
        key=lambda x: (
            priority.get(
                x["confidence"],
                9,
            ),
            -(
                x["best_rssi"]
                if x["best_rssi"]
                is not None
                else -999
            ),
        )
    )


    # High-volume families remain visible in normal mode,
    # but are summarized rather than dumped individually.

    background_categories = {
        "FIND-MY",
        "APPLE NEARBY",
    }

    background = Counter()

    foreground_ble = []

    for item in ble_matches:

        if (
            not verbose
            and item["category"]
            in background_categories
        ):
            background[
                item["category"]
            ] += 1
        else:
            foreground_ble.append(
                item
            )


    # --------------------------------------------------------
    # HEADER
    # --------------------------------------------------------

    print("DEVICE WATCH")

    wifi_status = wifi_result.get("status")

    ble_label = "unavailable"

    if ble_error:
        ble_label=f"{bt_adapter or 'no adapter'} FAILED · {ble_error}"
    elif bt_adapter:
        ble_label=f"{bt_adapter} ({radio_type}) {len(ble_devices)} seen · {duration}s observed"
        if not ble_devices:
            print('BLE: no advertisements received; not evidence that devices are absent.',flush=True)

    if wifi_status == "ok":

        wifi_label = (
            f"{'+'.join(wifi_result.get('interfaces') or [wifi_result['interface']])} "
            f"{len(wifi_result['rows'])} BSSIDs / "
            f"{len(wifi_result['groups'])} APs"
        )

    elif wifi_status == "disabled":

        wifi_label = "disabled"

    else:

        wifi_label = "unavailable: " + str(wifi_result.get("reason", "No usable scan result"))


    print(f"BLE  : {ble_label}")
    print(f"WiFi : {wifi_label}")
    for coverage in wifi_result.get('coverage', []):
        print("WiFi radio: "+coverage['adapter']+" · "+' / '.join(coverage['bands'])+" · "+coverage['status'])
    for note in wifi_result.get('coverage_notes', []):
        print('WiFi coverage: '+note)

    print(
        f"HIGH {counts['HIGH']} | "
        f"LIKELY {counts['LIKELY']} | "
        f"POSS {counts['POSSIBLE']} | "
        f"INFO {counts['INFO']}"
    )


    # ========================================================
    # NORMAL / COMPACT MODE
    # ========================================================

    if not verbose:

        if foreground_ble:

            print()
            print("DETECTED")

            for item in foreground_ble:

                rec = item["record"]

                identity = ble_identity(
                    item
                )

                signal = rssi_text(
                    item
                )

                line = (
                    f"{item['confidence']:<8} "
                    f"{item['category']:<12} "
                    f"{identity}"
                )

                if signal:
                    line += f"  {signal}"

                print(line)

                detail = rec["address"]

                evidence = compact_evidence(
                    item
                )

                if evidence:
                    detail += (
                        f" | {evidence}"
                    )

                print(
                    f"         {detail}"
                )


        if background:

            print()
            print("BACKGROUND")

            parts = []

            for category in (
                "FIND-MY",
                "APPLE NEARBY",
            ):

                amount = background.get(
                    category,
                    0,
                )

                if amount:
                    parts.append(
                        f"{category} {amount}"
                    )

            if parts:
                print(
                    " | ".join(parts)
                )


        if wifi_findings:

            print()
            print("WIFI ALERTS")

            for item in wifi_findings:

                signal = ""

                if item["signal"] is not None:
                    signal = (
                        f"  "
                        f"{item['signal']:.0f}dBm"
                    )

                print(
                    f"{item['confidence']:<8} "
                    f"{item['ssid']}  "
                    f"{item['bssid']}"
                    f"{signal}"
                )

                why = " | ".join(
                    item["reasons"]
                )

                if why:
                    print(
                        f"         {why}"
                    )

        else:

            print()
            print("WiFi alerts : 0")


        if (
            not foreground_ble
            and not background
            and not wifi_findings
        ):

            print()
            print("No classified devices.")


        print()
        print(
            f"Unknown BLE : "
            f"{max(0, len(ble_devices) - len(ble_matches))}"
        )

        print(
            "Passive observation only."
        )

        if created_ble_targets:

            print()
            print("RUN TARGET:")

            for filename in created_ble_targets:
                print(
                    str(target_dir / filename)
                )

        record_history_after_summary()
        return 2 if ble_error else 0


    # ========================================================
    # DETAILS / SHOW MODE
    # ========================================================

    print()
    print("DETAIL EVIDENCE")

    if show_query:
        print(
            f"Filter           : {args.show}"
        )

    print(
        f"BLE scan seconds : {duration}"
    )

    print(
        f"BLE observed     : {len(ble_devices)}"
    )

    print(
        f"BLE classified   : {len(ble_matches)}"
    )

    print(
        f"BLE unknown      : "
        f"{max(0, len(ble_devices) - len(ble_matches))}"
    )

    print(
        f"WiFi observed    : "
        f"{len(wifi_result.get('rows', []))}"
    )

    print(
        f"WiFi findings    : {len(wifi_findings)}"
    )


    def matches_show(*values):

        if not show_query:
            return True

        for value in values:

            if value is None:
                continue

            if show_query in str(
                value
            ).lower():
                return True

        return False


    # --------------------------------------------------------
    # BLE: show ALL observed records, not only classified ones.
    # --------------------------------------------------------

    classified_by_address = {
        item["record"]["address"]: item
        for item in ble_matches
    }

    shown_ble = 0

    for rec in sorted(
        ble_devices.values(),
        key=lambda x: (
            x.get("name") or "",
            x.get("address") or "",
        ),
    ):

        item = classified_by_address.get(
            rec["address"]
        )

        category = (
            item["category"]
            if item
            else "UNCLASSIFIED"
        )

        confidence = (
            item["confidence"]
            if item
            else "INFO"
        )

        reason = (
            item["reason"]
            if item
            else "No classification rule matched"
        )

        if not matches_show(
            rec.get("name"),
            rec.get("address"),
            category,
            confidence,
            reason,
            *rec.get("uuids", []),
        ):
            continue

        if shown_ble == 0:
            print()
            print("BLE OBSERVATIONS")

        shown_ble += 1

        print()
        print(
            f"{confidence} {category}"
        )

        print(
            f"Name       : "
            f"{rec.get('name') or '-'}"
        )

        print(
            f"Address    : "
            f"{rec.get('address') or '-'}"
        )

        rssis = rec.get(
            "rssis",
            [],
        )

        last_rssi = (
            rssis[-1]
            if rssis
            else None
        )

        best_rssi = (
            max(rssis)
            if rssis
            else None
        )

        if last_rssi is not None:
            print(
                f"RSSI       : "
                f"{last_rssi} dBm "
                f"{signal_label(last_rssi)}"
            )
        else:
            print("RSSI       : -")

        if best_rssi is not None:
            print(
                f"Best RSSI  : {best_rssi} dBm"
            )

        print(
            f"Samples    : {len(rssis)}"
        )

        tx_power = rec.get(
            "tx_power"
        )

        if tx_power not in (
            None,
            0,
        ):
            print(
                f"TxPower    : "
                f"{tx_power}"
            )

        elif tx_power == 0:
            print(
                "TxPower    : -"
            )

        print(
            f"Reason     : {reason}"
        )

        if rec.get("uuids"):
            print("UUIDs:")

            for uuid in sorted(
                rec["uuids"]
            ):
                print(
                    f"  {uuid}"
                )

        if rec.get(
            "manufacturer"
        ):
            print(
                "Manufacturer data:"
            )

            for key, value in sorted(
                rec["manufacturer"].items()
            ):
                print(
                    f"  0x{key:04X}: "
                    f"{bytes(value).hex()}"
                )

        if rec.get(
            "service_data"
        ):
            print(
                "Service data:"
            )

            for key, value in sorted(
                rec["service_data"].items()
            ):
                print(
                    f"  {key}: "
                    f"{bytes(value).hex()}"
                )


    # --------------------------------------------------------
    # Wi-Fi: show ALL BSSIDs from the passive wifi-scan
    # manifest, not merely anomaly findings.
    # --------------------------------------------------------

    shown_wifi = 0

    finding_by_bssid = {
        str(
            item.get("bssid", "")
        ).upper(): item
        for item in wifi_findings
        if item.get("bssid")
    }

    if wifi_status == "ok":

        for row in wifi_result.get(
            "rows",
            [],
        ):

            ssid = str(
                row.get("ssid", "")
            )

            bssid = str(
                row.get("bssid", "")
            ).upper()

            security = str(
                row.get("security", "")
            )

            if not matches_show(
                ssid,
                bssid,
                security,
                *[
                    value
                    for value
                    in row.values()
                    if isinstance(
                        value,
                        (
                            str,
                            int,
                            float,
                        ),
                    )
                ],
            ):
                continue

            if shown_wifi == 0:
                print()
                print("WIFI OBSERVATIONS")

            shown_wifi += 1

            print()
            print(
                f"SSID       : "
                f"{ssid or '-'}"
            )

            print(
                f"BSSID      : "
                f"{bssid or '-'}"
            )

            if security:
                print(
                    f"Security   : {security}"
                )

            if row.get(
                "sig"
            ) is not None:
                print(
                    f"RSSI       : "
                    f"{row.get('sig')} dBm"
                )

            # Print other passive manifest fields so details
            # remains useful even if wifi-scan adds fields later.
            skip = {
                "ssid",
                "bssid",
                "security",
                "sig",
            }

            for key in sorted(row):

                if key in skip:
                    continue

                value = row.get(key)

                if value in (
                    None,
                    "",
                    [],
                    {},
                ):
                    continue

                print(
                    f"{key:<11}: {value}"
                )

            anomaly = finding_by_bssid.get(
                bssid
            )

            if anomaly:
                print(
                    f"Finding    : "
                    f"{anomaly['confidence']} "
                    f"{anomaly['category']}"
                )

                for why in anomaly.get(
                    "reasons",
                    [],
                ):
                    print(
                        f"Reason     : {why}"
                    )


    if show_query:

        if (
            shown_ble == 0
            and shown_wifi == 0
        ):
            print()
            print(
                "No passive observations matched "
                f"'{args.show}'."
            )

        else:
            print()
            print(
                f"Matched BLE  : {shown_ble}"
            )
            print(
                f"Matched WiFi : {shown_wifi}"
            )


    print()
    print(
        "Passive observation only."
    )

    record_history_after_summary()
    return 2 if ble_error else 0


if __name__ == "__main__":
