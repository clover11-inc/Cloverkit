def select_bt_adapter(requested=None):

    if requested:
        if requested not in ("hci0", "hci1"):
            raise RuntimeError(
                f"Invalid radio: {requested}"
            )

        if not adapter_exists(requested):
            raise RuntimeError(
                f"{requested} not available"
            )

        return requested

    if adapter_exists("hci1"):
        return "hci1"

    if adapter_exists("hci0"):
        return "hci0"

    raise RuntimeError("NO BLUETOOTH")


def valid_rssi(value):

    if value is None:
        return False

    return -126 <= value <= 20


def signal_label(value):

    if value is None:
        return "?"

    if value >= -50:
        return "VERY STRONG"

    if value >= -60:
        return "STRONG"

    if value >= -70:
        return "GOOD"

    if value >= -80:
        return "WEAK"

    return "VERY WEAK"


def uuid_present(record, *wanted):

    have = {
        x.lower()
        for x in record["uuids"]
    }

    wanted = {
        x.lower()
        for x in wanted
    }

    return bool(
        have.intersection(wanted)
    )


def manufacturer_payload(record, company_id):

    data = record["manufacturer"].get(
        company_id
    )

    if data is None:
        return b""

    return bytes(data)


def service_payload(record, uuid_fragment):

    wanted = uuid_fragment.lower()

    for uuid, data in record[
        "service_data"
    ].items():

        if wanted in uuid.lower():
            return bytes(data)

    return b""


def classify_ble(record):

    name = (
        record["name"]
        .lower()
        .strip()
    )

    uuids = {
        x.lower()
        for x in record["uuids"]
    }


    # ========================================================
    # FLIPPER ZERO
    #
    # Strong exact UUID evidence.
    # Device name is irrelevant.
    # ========================================================

    matched_flipper = (
        uuids & FLIPPER_UUIDS
    )

    if matched_flipper:

        return (
            "FLIPPER",
            "HIGH",
            "Flipper service UUID",
        )


    if "flipper" in name:

        return (
            "FLIPPER",
            "POSSIBLE",
            "Flipper-like advertised name",
        )


    # ========================================================
    # APPLE FIND MY
    #
    # Apple manufacturer ID = 0x004C.
    #
    # 0x12 advertisements are strongly associated with
    # offline Find My-style beaconing.
    #
    # 0x07 is broader Apple nearby/proximity behaviour and
    # therefore deliberately kept informational.
    # ========================================================

    apple = manufacturer_payload(
        record,
        0x004C,
    )

    if apple:

        if apple[0] == 0x12:

            return (
                "FIND-MY",
                "LIKELY",
                "Apple 0x004C type 0x12",
            )


        if apple[0] == 0x07:

            return (
                "APPLE NEARBY",
                "INFO",
                "Apple 0x004C type 0x07",
            )


    # ========================================================
    # TILE
    #
    # Tile service UUID documented as:
    #
    # FEED0001-0000-1000-8000-00805F9B34FB
    # ========================================================

    if uuid_present(
        record,
        "feed0001-0000-1000-8000-00805f9b34fb",
    ):

        return (
            "TILE",
            "HIGH",
            "Tile FEED0001 service UUID",
        )


    # Tile manufacturer company ID.
    # Manufacturer alone is less specific.
    if 0x00C7 in record["manufacturer"]:

        return (
            "TILE?",
            "POSSIBLE",
            "Tile manufacturer ID 0x00C7",
        )


    # ========================================================
    # SAMSUNG SMARTTAG
    #
    # FD5A service is substantially stronger than Samsung
    # manufacturer ID by itself.
    # ========================================================

    if uuid_present(
        record,
        "0000fd5a-0000-1000-8000-00805f9b34fb",
    ):

        return (
            "SMARTTAG",
            "HIGH",
            "Samsung SmartTag FD5A service",
        )


    if (
        "smarttag" in name
        or "smart tag" in name
        or "galaxy tag" in name
    ):

        return (
            "SMARTTAG?",
            "POSSIBLE",
            "SmartTag-like advertised name",
        )


    # Samsung 0x0075 alone is far too broad.
    if 0x0075 in record["manufacturer"]:

        return (
            "SAMSUNG BLE",
            "INFO",
            "Samsung manufacturer ID 0x0075",
        )


    # ========================================================
    # OPEN DRONE ID / REMOTE ID
    #
    # ASTM Bluetooth Remote ID uses service UUID FFFA.
    # Application/message payload may begin with 0x0D.
    # ========================================================

    if uuid_present(
        record,
        "0000fffa-0000-1000-8000-00805f9b34fb",
    ):

        payload = service_payload(
            record,
            "fffa",
        )

        if (
            payload
            and payload[0] == 0x0D
        ):

            return (
                "DRONE-ID",
                "HIGH",
                "OpenDroneID FFFA + 0x0D",
            )

        return (
            "DRONE-ID",
            "POSSIBLE",
            "Remote-ID FFFA service",
        )


    # ========================================================
    # NORDIC UART
    #
    # Useful technology fingerprint but extremely common.
    # Never identify a Flipper from this alone.
    # ========================================================

    if uuid_present(
        record,
        "6e400001-b5a3-f393-e0a9-e50e24dcca9e",
    ):

        return (
            "NORDIC UART",
            "INFO",
            "Nordic UART service",
        )


    # ========================================================
    # POSSIBLE SKIMMER-ASSOCIATED SERIAL MODULES
    #
    # These names are also used by completely legitimate
    # hobby hardware.
    #
    # Therefore NEVER report them as confirmed skimmers.
    # ========================================================

    if name in {
        "hc-03",
        "hc03",
        "hc-05",
        "hc05",
        "hc-06",
        "hc06",
    }:

        return (
            "SKIMMER?",
            "POSSIBLE",
            "HC-series serial-module name",
        )


    # ========================================================
    # PAYMENT TERMINALS / READERS
    #
    # Informational only.
    # Seeing these in retail is completely normal.
    # ========================================================

    payment_names = (
        "square",
        "sumup",
        "verifone",
        "ingenico",
        "bbpos",
        "stripe reader",
        "stripe-reader",
        "zettle",
        "paypal here",
        "pax",
    )


    if any(
        x in name
        for x in payment_names
    ):

        return (
            "PAYMENT",
            "INFO",
            "Recognisable payment-device name",
        )


    # ========================================================
    # SECURITY / RF TOOLS
    #
    # Name evidence is spoofable, therefore POSSIBLE only.
    # ========================================================

    security_names = (
        "proxmark",
        "chameleon",
        "ubertooth",
        "hackrf",
        "yardstick",
        "yard stick",
        "marauder",
        "pwnagotchi",
        "wifi pineapple",
        "pineapple",
    )


    if any(
        x in name
        for x in security_names
    ):

        return (
            "RF/SEC TOOL",
            "POSSIBLE",
            "Recognisable tool name",
        )


    # ========================================================
    # DEVELOPMENT HARDWARE
    #
    # Interesting, but not suspicious.
    # ========================================================

    dev_names = (
        "esp32",
        "esp-32",
        "arduino",
        "nrf52",
        "nrf528",
        "raspberry pi",
    )


    if any(
        x in name
        for x in dev_names
    ):

        return (
            "DEV BOARD",
            "INFO",
            "Recognisable development-board name",
        )


    # Existing generic tracker-name fallback.
    if any(
        x in name
        for x in TRACKER_NAMES
    ):

        return (
            "TRACKER?",
            "POSSIBLE",
            "Known tracker-family name",
        )


    return None


async def scan_ble(
    adapter,
    duration,
    progress=None,
):

    devices = {}

    def callback(device, adv):

        address = device.address.upper()

        rec = devices.setdefault(
            address,
            {
                "address": address,
                "name": "",
                "rssis": [],
                "tx_power": None,
                "uuids": set(),
                "manufacturer": {},
                "service_data": {},
            },
        )

        name = adv.local_name or device.name

        if name:
            rec["name"] = name

        if valid_rssi(adv.rssi):
            rec["rssis"].append(adv.rssi)

        if adv.tx_power is not None:
            rec["tx_power"] = adv.tx_power

        for uuid in adv.service_uuids or []:
            rec["uuids"].add(
                uuid.lower()
            )

        for key, value in (
            adv.manufacturer_data or {}
        ).items():
            rec["manufacturer"][key] = bytes(value)

        for key, value in (
            adv.service_data or {}
        ).items():
            rec["service_data"][
                key.lower()
            ] = bytes(value)

        classification=classify_ble(rec)
        live_event(
            "ble_device",
            category=classification[0] if classification else None,
            phase="SCANNING BLE",
            adapter=adapter,
            seen=len(devices),
            address=address,
            name=rec["name"],
            rssi=(
                rec["rssis"][-1]
                if rec["rssis"]
                else None
            ),
        )

    scanner = BleakScanner(
        detection_callback=callback,
        bluez={"adapter": adapter},
    )

    try:
        await scanner.start()
    except BaseException:
        # Release this scanner's discovery session if start partially succeeded.
        try: await scanner.stop()
        except Exception: pass
        raise

    started = time.monotonic()

    if progress:
        progress(
            0,
            duration,
            "Scanning BLE",
        )

    try:
        while True:
            elapsed = (
                time.monotonic()
                - started
            )

            if elapsed >= duration:
                break

            remaining = (
                duration - elapsed
            )

            await asyncio.sleep(
                min(
                    0.25,
                    remaining,
                )
            )

            if progress:
                progress(
                    min(
                        max(0.0, duration - 0.01),
                        time.monotonic() - started,
                    ),
                    duration,
                    "Scanning BLE",
                )

    finally:
        await scanner.stop()

    if progress:
        progress(
            duration,
            duration,
            "Scanning BLE",
        )

    return devices


